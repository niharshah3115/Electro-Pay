rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // CORE AUTHENTICATION & ACCESS CONTROL HELPER FUNCTIONS
    // ============================================================================

    // 1. Verify caller is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // 2. Verify caller matches the target owner user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 3. Verify that the incoming document or existing document belongs to the caller
    function isDocumentOwner(docData) {
      return isAuthenticated() && (
        docData.distributorId == request.auth.uid ||
        docData.userId == request.auth.uid
      );
    }

    // ============================================================================
    // ROOT-LEVEL COLLECTIONS
    // ============================================================================

    // 1. Distributors Profile Collection
    // Schema: /distributors/{userId}
    match /distributors/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // 2. Shopkeepers / Retailers Collection
    // Schema: /shopkeepers/{shopkeeperId}
    match /shopkeepers/{shopkeeperId} {
      // Prevent unauthorized read & cross-user read
      allow read: if isAuthenticated() && resource.data.distributorId == request.auth.uid;
      
      // Prevent unauthorized write & cross-user write
      allow create: if isAuthenticated() && 
        request.resource.data.distributorId == request.auth.uid &&
        request.resource.data.shopName is string &&
        request.resource.data.phone is string;
      
      // Prevent updating distributorId to another user
      allow update: if isAuthenticated() && 
        resource.data.distributorId == request.auth.uid &&
        request.resource.data.distributorId == request.auth.uid;
      
      // Only the owning distributor can delete
      allow delete: if isAuthenticated() && resource.data.distributorId == request.auth.uid;
    }

    // 3. Payments Ledger Collection
    // Schema: /payments/{paymentId}
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.distributorId == request.auth.uid;
      
      allow create: if isAuthenticated() && 
        request.resource.data.distributorId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      
      allow update: if isAuthenticated() && 
        resource.data.distributorId == request.auth.uid &&
        request.resource.data.distributorId == request.auth.uid;
      
      allow delete: if isAuthenticated() && resource.data.distributorId == request.auth.uid;
    }

    // 4. Invoices Collection
    // Schema: /invoices/{invoiceId}
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && resource.data.distributorId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.distributorId == request.auth.uid;
      allow update: if isAuthenticated() && 
        resource.data.distributorId == request.auth.uid &&
        request.resource.data.distributorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.distributorId == request.auth.uid;
    }

    // 5. Call Logs Collection
    // Schema: /callLogs/{callLogId}
    match /callLogs/{callLogId} {
      allow read: if isAuthenticated() && resource.data.distributorId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.distributorId == request.auth.uid;
      allow update: if isAuthenticated() && 
        resource.data.distributorId == request.auth.uid &&
        request.resource.data.distributorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.distributorId == request.auth.uid;
    }

    // ============================================================================
    // USER-NESTED SUBCOLLECTIONS (For hierarchical schemas)
    // ============================================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================================================
    // DEFAULT CATCH-ALL: DENY EVERYTHING ELSE
    // ============================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
